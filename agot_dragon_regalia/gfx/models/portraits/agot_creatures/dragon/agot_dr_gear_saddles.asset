# AGOT - Dragon Regalia : Equipement (selles). FICHIER GENERE (scratchpad gen_gear.ps1) - ne pas editer a la main.
# Copie fidele de saddle_entity (AGOT, saddle.asset) ; seule la variation change.
# PHASE 2 (Blender) : un caparacon brode du vrai blason (coat_of_arms) et des ornements de cornes demandent de NOUVEAUX maillages ;
# ils viendront ici sous forme de nouvelles entites (ex. agot_dr_gear_caparison_entity, agot_dr_gear_horn_ornament_entity).

entity = {
	name = "agot_dr_gear_war_gold_style_entity"
	pdxmesh = "saddle_mesh"
	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
			portrait_accessory = {
				pattern_mask = "gfx/models/portraits/agot_creatures/dragon/saddle/saddle_masks.dds"
				variation = "agot_dr_gear_war_gold_style"
			}
		}
	}
	attribute = { name = "bs_dragon_large"						blend_shape = "saddle_dragon_large" }
	attribute = { name = "dragon_infant_proportions" 			additive_animation = "dragon_infant_proportions" default = 0.5 }
	attribute = { name = "dragon_large_proportions" 			additive_animation = "dragon_large_proportions" default = 0.5 }
	get_state_from_parent = yes
	state = {	name = "dragon_static"						animation = "dragon_idle_1" 					looping = no animation_speed = 1.0 animation_blend_time = 0.3 }
